# Dockerfile for building EIF files
# This creates a container with nitro-cli and all dependencies installed
# Following official AWS installation guide: https://docs.aws.amazon.com/enclaves/latest/user/nitro-enclave-cli-install.html

FROM amazonlinux:2023

# Install system dependencies and AWS Nitro Enclaves CLI
RUN dnf update -y && \
    dnf install -y \
    aws-nitro-enclaves-cli \
    aws-nitro-enclaves-cli-devel \
    docker \
    && dnf clean all

# Create required directories
RUN mkdir -p /usr/share/nitro_enclaves/blobs/

WORKDIR /workspace

# Entry point script
COPY build-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/build-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/build-entrypoint.sh"]

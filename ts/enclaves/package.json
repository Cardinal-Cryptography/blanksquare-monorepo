{
  "name": "@cardinal-cryptography/enclaves",
  "version": "0.3.0",
  "description": "AWS Nitro Enclaves attestation verification module for the Cardinal ecosystem",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
  "keywords": [
    "aws",
    "nitro",
    "enclaves",
    "attestation",
    "verification",
    "tee",
    "trusted-execution-environment"
  ],
  "author": "Cardinal",
  "license": "Apache-2.0",
  "files": [
    "/dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@cardinal-cryptography/ecies-encryption-lib": "^0.2.0",
    "@noble/secp256k1": "^2.3.0",
    "asn1js": "^3.0.6",
    "cbor": "^10.0.9",
    "cbor-web": "^10.0.9",
    "pkijs": "^3.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cbor": "^6.0.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.0.1"
  }
}
